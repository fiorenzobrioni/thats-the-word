<?xml version="1.0" encoding="utf-8"?>
<!--
  The home-screen card (PLANNING.md §7.8, §10): its receiver, the settings page the launcher opens
  on a placement and a long press, and what keeps the card fresh. No permission of its own. Glance
  brings WorkManager, with its WAKE_LOCK (held by a job while it runs), RECEIVE_BOOT_COMPLETED (to
  re-arm its jobs after a reboot), FOREGROUND_SERVICE and ACCESS_NETWORK_STATE (which lets nothing
  leave the phone: there is no INTERNET permission); all left as WorkManager declares them. The
  midnight alarm is AlarmManager.set(RTC): inexact, non-wakeup, no permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:supportsRtl="true">
        <!-- Reached from the launcher's placement and reconfigure flow. Exported, because the
             launcher starts it; taskAffinity empty, so it never lands on top of the game's task. -->
        <activity
            android:name=".config.WidgetConfigActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.ThatsTheWord.WidgetConfig">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- exported=false: the system delivers APPWIDGET_* to it regardless. -->
        <receiver
            android:name=".TodayCardReceiver"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- The midnight alarm: the game's own pending intent, nobody else's. -->
        <receiver
            android:name=".refresh.MidnightReceiver"
            android:exported="false" />

        <!-- The broadcasts Android exempts from the implicit-broadcast limits, sent by the system
             alone; exported=false still receives them. -->
        <receiver
            android:name=".refresh.WidgetSystemReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
