<?xml version="1.0" encoding="utf-8"?>
<!--
  «Today's word» (PLANNING.md §7.8): today's word in each language and the streak. Placed four
  cells by two; at least one cell (40 dp by the platform's 70 × n − 30); no maximum. Every form
  has a layout for any grant (CardFit).

  updatePeriodMillis is 0: the card is pushed (a game saved, the midnight alarm, the exempt
  broadcasts), never polled. The settings page is optional, so a card is placed at once with its
  defaults; a long press opens it.

  previewLayout is what the picker shows before the launcher asks for a generated preview (API
  35+, GlanceAppWidget.providePreview): a static drawing of the default card, sample tiles only.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.callbackdev.thatstheword.widget.config.WidgetConfigActivity"
    android:description="@string/widget_desc"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_today_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
